# Server only. Obtain a Vercel AI Gateway key from the Vercel dashboard.
AI_GATEWAY_API_KEY=
# Existing MDF provider (optional)
ROBOFLOW_API_KEY=

# Published APIs fail closed until all access/consumption controls are configured.
# Use a separate random password (20+ characters), never the AI Gateway key.
VQC_REMOTE_ENABLED=false
VQC_ACCESS_PASSWORD=
# Shared across both providers and all instances; UTC daily reset.
VQC_REQUESTS_PER_MINUTE=6
VQC_REQUESTS_PER_DAY=60
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional: exercise deployed access policy locally.
VQC_ENFORCE_ACCESS=false

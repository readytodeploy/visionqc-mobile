# Only two values are required for direct Jev in Vercel Production. Keep both server-side.
AI_JEV_API_KEY=
# Separate random inspection password, at least 20 characters. Never use the API key here.
VQC_ACCESS_PASSWORD=

# Optional emergency switch: false disables remote inspection. Unset otherwise.
# VQC_REMOTE_ENABLED=false
# Optional limits per warm function instance (not a global spending cap).
# VQC_REQUESTS_PER_MINUTE=6
# VQC_REQUESTS_PER_DAY=60
# Optional existing MDF provider.
# ROBOFLOW_API_KEY=
# Optional: exercise deployed access policy locally.
# VQC_ENFORCE_ACCESS=true
